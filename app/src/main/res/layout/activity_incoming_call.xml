<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/activity_main"
        tools:context=".calls.InComingCallActivity"
        android:background="@color/colorBlueImg">

        <ImageView
            android:id="@+id/called_profile_pic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop">

        </ImageView>

        <TextView
            android:id="@+id/called_username"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center_horizontal"
            android:text="Username"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="30dp"
            android:textStyle="bold">

        </TextView>

        <TextView
            android:id="@+id/txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/called_username"
            android:layout_marginBottom="-50dp"
            android:gravity="center_horizontal"
            android:text="Calling..."
            android:textAlignment="center"
            android:textColor="#000"
            android:textSize="30dp">

        </TextView>

        <FrameLayout
            android:id="@+id/local_video_view_container"
            android:layout_width="320dp"
            android:layout_height="240dp"
            android:layout_centerHorizontal="true"
            android:layout_margin="6dp"
            android:background="@android:color/darker_gray" />

        <FrameLayout
            android:id="@+id/remote_video_view_container"
            android:layout_width="320dp"
            android:layout_height="240dp"
            android:layout_below="@+id/local_video_view_container"
            android:layout_centerHorizontal="true"
            android:layout_margin="6dp"
            android:background="@android:color/darker_gray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="60dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/make_call"
                android:onClick="joinChannel"
                app:tint="@color/colorRed"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="98dp"
                android:src="@drawable/ic_video_call" />

            <ImageView
                android:id="@+id/decline_call"
                app:tint="@color/colorRed"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/red_circle"
                android:padding="10dp"
                android:src="@drawable/ic_phone_call_end" />
        </LinearLayout>

    </RelativeLayout>
</layout>