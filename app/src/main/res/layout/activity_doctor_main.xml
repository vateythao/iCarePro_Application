<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".doctor.DoctorMainActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_10"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="5dp"
                app:layout_constraintTop_toTopOf="parent">

                <RadioGroup
                    android:id="@+id/radioTabSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <RadioButton
                        android:id="@+id/radioChats"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_40"
                        android:layout_weight="1"
                        android:background="@drawable/radio_selection_item_left_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="6dp"
                        android:paddingHorizontal="16dp"
                        android:text="Chats"
                        android:textColor="@color/colorTextHint"
                        android:textSize="14sp"
                        tools:checked="true" />

                    <RadioButton
                        android:id="@+id/radioAppointment"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/dp_40"
                        android:layout_weight="1"
                        android:background="@drawable/radio_selection_item_center_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="6dp"
                        android:paddingHorizontal="16dp"
                        android:text="Appointment"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                </RadioGroup>

            </androidx.cardview.widget.CardView>

            <FrameLayout
                android:id="@+id/mainContainerDoctor"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>