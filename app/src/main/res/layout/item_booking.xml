<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/dp_10"
        app:cardElevation="@dimen/dp_5"
        app:cardMaxElevation="@dimen/dp_5"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNamePatent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_10"
                android:padding="@dimen/dp_5"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:text="Doctor Name: Pradeep Rai" />

            <TextView
                android:id="@+id/txtBookingDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_10"
                android:padding="@dimen/dp_5"
                android:textColor="@color/black"
                android:textSize="12sp"
                tools:text="Appointment Date: 31 October 2023" />

            <TextView
                android:id="@+id/txtBookingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_10"
                android:padding="@dimen/dp_5"
                android:textColor="@color/black"
                android:textSize="12sp"
                tools:text="Appointment Time: 15:53" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>