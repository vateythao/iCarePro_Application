<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".calls.AudioCallActivity">

        <LinearLayout
            android:id="@+id/llToolBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/themeBlue"
            android:orientation="vertical"
            android:padding="10dp"
            android:paddingHorizontal="10dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/back_arrow" />
            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="match_parent"
            android:layout_height="450dp"
            android:src="@drawable/background_bottom_tint"
            app:layout_constraintTop_toBottomOf="@+id/llToolBar" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:src="@drawable/girl_doctor"
            app:layout_constraintBottom_toBottomOf="@+id/imgBack" />

        <LinearLayout
            android:id="@+id/llCallSetting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/imgBack">

            <ImageView
                android:id="@+id/btnJoinCall"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="20dp"
                android:src="@drawable/ic_telephone" />

            <ImageView
                android:id="@+id/LeaveButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/purple_btn_bg"
                android:layout_marginHorizontal="20dp"
                android:onClick="leaveChannel"
                android:padding="@dimen/dp_5"
                android:src="@drawable/ic_phone_call_end" />
        </LinearLayout>

        <TextView
            android:id="@+id/infoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:text="Press the button to join a channel"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llCallSetting" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>