<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/jisko_call_kiya_hai_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/colorBlueImg">

                <androidx.cardview.widget.CardView
                    android:layout_width="200dp"
                    android:layout_height="350dp"
                    android:layout_gravity="top|end"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="5dp"
                    app:cardUseCompatPadding="true">

                    <FrameLayout
                        android:id="@+id/jisne_call_kiya_hai_container"
                        android:layout_width="200dp"
                        android:layout_height="350dp"
                        android:background="@color/logInfo" />

                </androidx.cardview.widget.CardView>


            </FrameLayout>


        </FrameLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_alignParentBottom="true">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentBottom="true"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="30dp"
                android:layout_toLeftOf="@id/img_cutcall"
                android:background="@drawable/circle_white"
                android:padding="10dp"
                android:src="@drawable/baseline_volume_up"
                app:tint="@color/colorfacebook" />

            <ImageView
                android:id="@+id/img_cutcall"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="80dp"
                android:background="@drawable/red_circle"
                android:padding="10dp"
                android:src="@drawable/ic_phone_call_end" />

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="20dp"
                android:layout_marginBottom="30dp"
                android:layout_toRightOf="@id/img_cutcall"
                android:background="@drawable/circle_white"
                android:padding="10dp"
                android:src="@drawable/baseline_videocam"
                app:tint="@color/colorfacebook" />

        </RelativeLayout>

    </RelativeLayout>

</layout>